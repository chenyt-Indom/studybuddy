# 复制为 .env 后填写；也可以直接在前端「设置」页里填（推荐，会加密存到 data/secrets.bin）
# 环境变量优先级最高，适合临时覆盖或 CI。

# ---------- DeepSeek（当前默认）----------
DEEPSEEK_API_KEY=
# 模型名：deepseek-flash（= V4.1 Flash，推荐）/ deepseek-v4-pro
# 注意 deepseek-chat、deepseek-reasoner 已于 2026-07-24 弃用
DEEPSEEK_MODEL=deepseek-flash

# ---------- 中国电信星辰（备选）----------
TELEAI_APP_KEY=
# 必填，去控制台「模型广场 → 模型详情 → 调用示例」抄
TELEAI_MODEL=

# ---------- 通用覆盖（一般不用填）----------
# LLM_BASE_URL=https://api.deepseek.com/v1
